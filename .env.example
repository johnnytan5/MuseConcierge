# Meta Model API (server-side only, never NEXT_PUBLIC_)
META_API_KEY=
# Optional model overrides
# SPARK_MODEL=muse-spark-1.1        # call agent; 1.1 is ~2x faster than 1.3 on call turns
# BRAIN_MODEL=muse-wonder-1.0       # set muse-spark-1.1 while testing to save credits

# Speech-to-text. Muse Voice Transcribe goes through the relay
# (scripts/asr-relay.mjs) because Muse takes the key inside the socket.
NEXT_PUBLIC_ASR_RELAY_URL=ws://localhost:8787
# NEXT_PUBLIC_ASR_PROVIDER=assemblyai   # force the backup transcriber
ASSEMBLYAI_API_KEY=   # backup transcriber and the agent's voice
# TTS_VOICE=aai-sara   # any AssemblyAI voice id; server-side

# Relay only: pages allowed to connect (comma-separated origins)
ASR_RELAY_ORIGINS=http://localhost:3000

# Supabase (service-role key: server-side only). Apply
# supabase/migrations/*_muse_fleet_state.sql once for saved runs and call limits.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Demo: fire the battery fault automatically on the first delivery (same as ?demo=1)
# NEXT_PUBLIC_DEMO_MODE=1

# Daily call limit on the hosted site (default: on, 3 calls per IP per day).
# Off lets anyone with the link spend your Meta credits. Rebuild after changing.
# NEXT_PUBLIC_CALL_LIMIT_ENABLED=false
# NEXT_PUBLIC_CALLS_PER_IP_PER_DAY=3

# Vercel cron keep-alive: any long random value, set in Vercel; Vercel sends it to the route
# CRON_SECRET=
