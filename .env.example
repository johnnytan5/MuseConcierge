# Meta Model API (server-side only)
META_API_KEY=
# Optional overrides
# SPARK_MODEL=muse-spark-1.3
# BRAIN_MODEL=muse-wonder-1.0   # muse-spark-1.3 while testing saves credits

# Speech-to-text: meta (default) or assemblyai (backup)
ASR_PROVIDER=meta
ASSEMBLYAI_API_KEY=

# Supabase (service-role key: server-side only, never NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
