<!--
  Muse Concierge: the hotel floor. Coordinates match lib/fleet/nav.ts (metres,
  z up). A lobby with the front desk, then an L-shaped corridor 1.3 m wide:
  the near arm runs east along y = 0 past rooms 803 and 804, the far arm runs
  north along x = 3 past rooms 1204 and 1205.

  Each robot is a tall delivery cabinet: a shell with a screen facing +x and a
  two-panel sliding door on its -y side (top panel up, bottom panel down) over
  a shallow cabin. Under it: two driven wheels and two frictionless casters.
  Wheels use velocity actuators, so wheel speed (rad/s) tracks ctrl closely and
  lib/sim/mjsim.ts can convert (v, w) directly. Shell geoms carry no contact;
  one cylinder stands in for the tower.
-->
<mujoco model="muse_concierge_floor">
  <option timestep="0.004" integrator="implicitfast"/>

  <visual>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.6 0.6 0.6"/>
  </visual>

  <default>
    <geom friction="1 0.005 0.0001" solref="0.01 1"/>
    <default class="deco">
      <geom contype="0" conaffinity="0"/>
    </default>
    <default class="wheel">
      <geom type="cylinder" size="0.06 0.02" rgba="0.12 0.12 0.12 1" friction="1.2 0.005 0.0001" euler="90 0 0"/>
      <joint type="hinge" axis="0 1 0" damping="0.02"/>
    </default>
    <default class="caster">
      <geom type="sphere" size="0.03" rgba="0.3 0.3 0.3 1" condim="1" friction="0 0 0" priority="1"/>
    </default>
  </default>

  <worldbody>
